#!/usr/bin/env bash
# Launch Pi as Samwise, with the environment from lib/env.sh and the execution
# fence on. pi-sandbox fails open, so refuse to start unless the fence will
# come up (sandbox D7). Only off macOS, where the fence cannot run, does
# SAMWISE_UNSANDBOXED=1 start Pi unfenced.
set -euo pipefail

repo="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=../lib/env.sh
source "$repo/lib/env.sh"
export PATH="$repo/bin:$PATH" # samwise-reflect

refuse() {
  printf 'samwise: %s\n' "$1" >&2
  exit 2
}

# Pi sets a boolean flag given as --flag=<value> to true whatever the value, so
# --no-sandbox=false would switch the fence off too.
for arg in "$@"; do
  if [[ "$arg" == --no-sandbox || "$arg" == --no-sandbox=* ]]; then
    refuse "--no-sandbox is not allowed; Samwise always runs with the sandbox"
  fi
done

if [[ "$(uname -s)" != Darwin ]]; then
  if [[ "${SAMWISE_UNSANDBOXED:-}" != 1 ]]; then
    refuse "the sandbox only runs on macOS; set SAMWISE_UNSANDBOXED=1 to run unfenced here (dev and eval only)"
  fi
  printf 'samwise: WARNING: running WITHOUT the sandbox (SAMWISE_UNSANDBOXED=1)\n' >&2
  exec pi --no-sandbox "$@"
fi

# The opt-in exists only where the fence cannot run. On macOS refuse it rather
# than ignore it, so a leftover or inherited opt-in is noticed.
if [[ ${SAMWISE_UNSANDBOXED+x} ]]; then
  refuse "SAMWISE_UNSANDBOXED is not honoured on macOS; unset it"
fi
if ! node "$repo/lib/sandbox/preflight.mjs" "$repo" "$PI_CODING_AGENT_DIR" "$PWD"; then
  refuse "sandbox preflight failed (see above); fix it or re-run bootstrap.sh"
fi
exec pi "$@"
