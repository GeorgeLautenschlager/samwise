{
  "rules": [
    {
      "when": "RUNNER-PASS",
      "steps": [
        {
          "tool": {
            "name": "bash",
            "args": {
              "command": "cat \"$PI_MEMORY_DIR/daily/2026-08-01.md\""
            }
          }
        },
        {
          "text": "Raise the prefetch, like PR #42."
        }
      ]
    },
    {
      "when": "RUNNER-FAIL",
      "steps": [
        {
          "text": "No idea, sorry."
        }
      ]
    },
    {
      "when": "RUNNER-KEYSTONE",
      "steps": [
        {
          "tool": {
            "name": "keystone_search",
            "args": {
              "query": "skiffline deploy"
            }
          }
        },
        {
          "text": "Deploy with Argo CD."
        }
      ]
    },
    {
      "when": "RUNNER-LEAK",
      "steps": [
        {
          "tool": {
            "name": "bash",
            "args": {
              "command": "echo 'Restart Skiffline first.' >> \"$(readlink \"$PI_CODING_AGENT_DIR/APPEND_SYSTEM.md\")\""
            }
          }
        },
        {
          "text": "Saved."
        }
      ]
    },
    {
      "when": "RUNNER-SEARCH",
      "steps": [
        {
          "tool": {
            "name": "memory_search",
            "args": {
              "query": "zebra"
            }
          }
        },
        {
          "text": "Raise the prefetch, like PR #42."
        }
      ]
    },
    {
      "when": "samwise-reflect context",
      "steps": [
        {
          "tool": {
            "name": "bash",
            "args": {
              "command": "samwise-reflect context"
            }
          }
        },
        {
          "tool": {
            "name": "bash",
            "args": {
              "command": "samwise-reflect propose <<'JSON'\n{\"items\": [{\"op\": \"add\", \"scope\": \"personal\", \"title\": \"Carrier calls\", \"body\": \"Skiffline carrier calls need a circuit breaker.\"}, {\"op\": \"add\", \"scope\": \"personal\", \"title\": \"Breakers\", \"body\": \"Prefer circuit breakers to longer timeouts.\"}], \"vocabulary\": [\"Skiffline\"]}\nJSON"
            }
          }
        },
        {
          "text": "Here is the proposal. Approve all, some or none?"
        }
      ]
    },
    {
      "when": "Approve everything",
      "steps": [
        {
          "text": "Run !samwise-reflect apply to apply it."
        }
      ]
    },
    {
      "when": "RUNNER-ORPHAN",
      "steps": [
        {
          "tool": {
            "name": "bash",
            "args": {
              "command": "setsid sleep 987 >/dev/null 2>&1 < /dev/null & echo launched"
            }
          }
        },
        {
          "text": "started"
        }
      ]
    }
  ]
}
